# All variables below are REQUIRED at runtime.
# The application MUST throw an error at startup if any of them is missing or empty.
# No defaults or fallbacks are allowed (see project CLAUDE.md "no fallback for configuration" rule).

# HTTP port the Fastify server will listen on.
PORT=3000

# Absolute or relative path to the directory containing published article HTML files.
ARTICLES_DIR=./articles

# Absolute or relative path to the JSON file used to persist the catalog index.
CATALOG_PATH=./data/catalog.json
