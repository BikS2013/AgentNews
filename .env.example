# All variables below are REQUIRED at runtime.
# The application MUST throw an error at startup if any of them is missing or empty.
# No defaults or fallbacks are allowed (see project CLAUDE.md "no fallback for configuration" rule).

# HTTP port the Fastify server will listen on.
PORT=3000

# Absolute or relative path to the directory containing published article HTML files.
ARTICLES_DIR=./articles

# Absolute or relative path to the JSON file used to persist the catalog index.
CATALOG_PATH=./data/catalog.json

# OPTIONAL — YouTube Data API v3 key, used ONLY by the `publish-article` CLI
# to enrich each new entry with the underlying video's upload date
# (stored as catalogEntry.youtubePublishedAt). The server does not read this.
#
# Behaviour matrix:
#   - unset/empty   -> publish CLI prints a single stderr warning and stores
#                      the entry without youtubePublishedAt (soft skip).
#   - set + valid   -> publish CLI fetches the date; failure (deleted video,
#                      HTTP error, non-YouTube thumbnail) also soft-skips.
#
# This is deliberate feature-gating, NOT a configuration fallback — no
# default key is ever substituted; the feature is simply off when the key
# is absent. Get a key from https://console.cloud.google.com/apis/credentials
# and enable the "YouTube Data API v3" on your Cloud project.
# YOUTUBE_API_KEY=
